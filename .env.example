# ============================================================
# RAG École — configuration (copier ce fichier en .env)
# ============================================================

# --- Profil docker compose ---
# "gpu" : lance vLLM sur la carte NVIDIA. Vide : utilise un LLM externe (voir LLM_BASE_URL).
COMPOSE_PROFILES=gpu

# --- Clés d'API (une par rôle) : À CHANGER ---
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(32))"
STUDENT_API_KEY=change-me-student
DIRECTION_API_KEY=change-me-direction
ADMIN_API_KEY=change-me-admin

# --- Modèle de langage (tout serveur compatible OpenAI) ---
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# vLLM (profil gpu)        : http://vllm:8000/v1
# Ollama sur l'hôte        : http://host.docker.internal:11434/v1   (LLM_MODEL_NAME=qwen2.5:7b)
# llama.cpp sur l'hôte     : http://host.docker.internal:8081/v1
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=768
HF_TOKEN=

# --- vLLM ---
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=8192

# --- Recherche ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
# EMBEDDING_DEVICE=cuda
TOP_K=5
MIN_SCORE=0.75
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Divers ---
SCHOOL_NAME=Lycée Jean Moulin
MAX_UPLOAD_MB=50
